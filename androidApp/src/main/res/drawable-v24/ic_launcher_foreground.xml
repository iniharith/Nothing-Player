<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing-style vinyl disc mark.
  Built to sit inside the 66dp adaptive-icon safe zone on a 108dp canvas,
  echoing the in-app disc (dark record, groove rings, red accent, white label).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer record body -->
    <path
        android:pathData="M24,54a30,30 0,1 0,60 0a30,30 0,1 0,-60 0"
        android:fillColor="#17181B"
        android:strokeColor="#3A3B3E"
        android:strokeWidth="1.2" />

    <!-- Groove rings -->
    <path
        android:pathData="M30,54a24,24 0,1 0,48 0a24,24 0,1 0,-48 0"
        android:fillColor="#00000000"
        android:strokeColor="#3A3B3E"
        android:strokeAlpha="0.55"
        android:strokeWidth="0.8" />
    <path
        android:pathData="M35,54a19,19 0,1 0,38 0a19,19 0,1 0,-38 0"
        android:fillColor="#00000000"
        android:strokeColor="#3A3B3E"
        android:strokeAlpha="0.55"
        android:strokeWidth="0.8" />

    <!-- Diagonal needle line, matching the in-app disc -->
    <path
        android:pathData="M31,66 L77,42"
        android:strokeColor="#4A4B4E"
        android:strokeWidth="0.8" />

    <!-- Red accent dot (Nothing brand red) -->
    <path
        android:pathData="M70,33.5a4,4 0,1 0,8 0a4,4 0,1 0,-8 0"
        android:fillColor="#D82132" />

    <!-- Center label -->
    <path
        android:pathData="M44,54a10,10 0,1 0,20 0a10,10 0,1 0,-20 0"
        android:fillColor="#FFFFFF"
        android:strokeColor="#535457"
        android:strokeWidth="0.6" />

    <!-- Spindle hole -->
    <path
        android:pathData="M51.8,54a2.2,2.2 0,1 0,4.4 0a2.2,2.2 0,1 0,-4.4 0"
        android:fillColor="#101013" />
</vector>
