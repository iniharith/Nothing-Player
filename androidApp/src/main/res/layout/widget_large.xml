<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Row: Track Meta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="No Song Playing"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="Open any music application"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FF3B30"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <!-- Lyrics viewport (3-4 lines scrolling preview) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Line 1: Previous Lyric (30% alpha) -->
        <TextView
            android:id="@+id/widget_lyric_prev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="..."
            android:textColor="#33FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <!-- Line 2: Active Lyric (100% white, bold, larger) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/widget_lyric_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text="Listening for active music stream..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 3: Next Lyric (60% alpha) -->
        <TextView
            android:id="@+id/widget_lyric_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text=""
            android:textColor="#66FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <!-- Line 4: Far Next Lyric (30% alpha) -->
        <TextView
            android:id="@+id/widget_lyric_line3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text=""
            android:textColor="#33FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
