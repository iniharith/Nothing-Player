<?xml version="1.0" encoding="utf-8"?>
<!-- Single-row strip variant (1x4): disc + title/lyric + compact transport -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="4dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Nothing Player"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lyric_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Play music to see lyrics"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_player_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:indeterminate="false"
            android:max="10000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_player_prev"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Previous"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_prev" />

    <FrameLayout
        android:id="@+id/widget_player_disc_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:contentDescription="Play or pause">

        <ImageView
            android:id="@+id/widget_player_disc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Spinning play or pause disc"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_player_play_pause"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_button_primary"
            android:contentDescription="Play or pause"
            android:padding="3dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/widget_player_next"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Next"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next" />

</LinearLayout>
