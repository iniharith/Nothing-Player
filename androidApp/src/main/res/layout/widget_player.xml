<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginEnd="86dp"
        android:layout_marginBottom="34dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Nothing Player"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Open music player first"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_lyric_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="Play music to see lyrics"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_player_disc_button"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginBottom="30dp"
        android:contentDescription="Play or pause">

        <ImageView
            android:id="@+id/widget_player_disc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Spinning play or pause disc"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_player_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_button_primary"
            android:contentDescription="Play or pause"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />
    </FrameLayout>

    <!-- Reference bottom media row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_player_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="Previous"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev" />

        <ProgressBar
            android:id="@+id/widget_player_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="10000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />

        <ImageButton
            android:id="@+id/widget_player_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="Next"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

</FrameLayout>
