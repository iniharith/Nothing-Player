<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF1A1A1A">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nothing Player"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add to home screen"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/widget_lyric_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play music to see lyrics"
        android:textColor="#FFFF3B30"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_lyric_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#66FFFFFF"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

</LinearLayout>
